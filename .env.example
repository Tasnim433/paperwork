# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (EU region)
DATABASE_URL=postgresql://user:password@host.eu-central-1.aws.neon.tech/paperwork?sslmode=require

# Generate with: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: extra origins for the auth API, comma-separated (e.g. http://192.168.1.10:3000)
BETTER_AUTH_TRUSTED_ORIGINS=

# Storage for original files: "local" (default, writes to LOCAL_STORAGE_DIR) or "r2"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads

# Cloudflare R2 (only when STORAGE_DRIVER=r2). Bucket created with EU jurisdiction.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI provider for classification, extraction and summaries: "google" (default) or "anthropic"
AI_PROVIDER=google
# Optional model override, e.g. gemini-flash-latest or claude-opus-5-5
AI_MODEL=
# Google AI Studio key (free tier may use inputs for training: only fictional documents)
GOOGLE_GENERATIVE_AI_API_KEY=
# Only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OCR language data cache (downloaded on first use)
TESSERACT_CACHE_DIR=.data/tesseract

# Inngest: local dev server needs no keys. In production set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY.
INNGEST_DEV=1
